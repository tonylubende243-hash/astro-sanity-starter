<!doctype html> <html lang="fr"> <head> <meta charset="utf-8" /> <meta name="viewport" content="width=device-width,initial-scale=1" /> <title>TL Management — Travel • Visa • Études • Immigration</title> <meta name="description" content="TL Management — Agence basée à Kinshasa (RDC) : voyages, assistance visa, études à l'étranger, immigration. Contact: tlmanagement243@gmail.com" /> <style> :root{ --orange:#F16522; --blue:#0C1D36; --bg:#f6f7fb; --card:#ffffff; --muted:#6b7280; --maxw:1100px; font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial; } *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--blue);-webkit-font-smoothing:antialiased} .wrap{max-width:var(--maxw);margin:26px auto;padding:18px} header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px;background:#fff;border-radius:10px;box-shadow:0 6px 20px rgba(12,29,54,0.06)} .brand{display:flex;gap:12px;align-items:center} .logo{width:64px;height:64px;border-radius:12px;display:grid;place-items:center;font-weight:800;color:#fff;background:linear-gradient(180deg,var(--orange),#e85903)} nav a{margin-left:14px;color:var(--blue);text-decoration:none;font-weight:700} .hero{display:grid;grid-template-columns:1fr 420px;gap:24px;align-items:center;margin-top:18px} @media(max-width:920px){.hero{grid-template-columns:1fr;padding:12px}nav{display:none}} h1{font-size:28px;margin:0} .lead{color:var(--muted);margin-top:8px} .btn{padding:12px 18px;border-radius:12px;border:0;cursor:pointer;font-weight:800} .btn-primary{background:var(--orange);color:#fff} .btn-ghost{background:transparent;border:2px solid rgba(12,29,54,0.08);color:var(--blue)} .card{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 8px 24px rgba(12,29,54,0.06)} .services{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px} @media(max-width:900px){.services{grid-template-columns:1fr}} .grid-two{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px} @media(max-width:700px){.grid-two{grid-template-columns:1fr}} footer{text-align:center;color:var(--muted);margin-top:18px;padding:12px} .contact-grid{display:grid;grid-template-columns:1fr 360px;gap:14px;margin-top:12px} @media(max-width:920px){.contact-grid{grid-template-columns:1fr}} input,textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid #e6e9ef;margin-top:8px;font-size:14px} label{font-weight:700;margin-top:10px;display:block} .small{font-size:13px;color:var(--muted)} .socials a{display:inline-block;margin-right:8px;padding:8px 12px;border-radius:8px;background:#fff;border:1px solid #eef2f6;text-decoration:none;color:var(--blue);font-weight:700} .payment-methods{display:flex;gap:8px;flex-wrap:wrap} .pay{padding:8px 10px;border-radius:8px;background:#fff;border:1px solid #eef2f6;font-weight:700} .form-note{font-size:13px;color:var(--muted);margin-top:8px} .hero-image img{width:100%;height:100%;object-fit:cover;border-radius:10px} .section-title{display:flex;align-items:center;gap:8px;margin-bottom:8px} .required{color:#d9534f;margin-left:6px} </style> </head> <body> <div class="wrap"> <header> <div class="brand"> <div class="logo">TL</div> <div> <div style="font-weight:900">TL Management</div> <div class="small">Prévoir, c’est gérer l’avenir • Kinshasa, RDC</div> </div> </div> <nav> <a href="#home">Accueil</a> <a href="#services">Services</a> <a href="#reservations">Réservations</a> <a href="#inscription">Inscription</a> <a href="#contact">Contact</a> </nav> </header> <main> <!-- HERO --> <section class="hero" id="home"> <div> <div class="badge" style="display:inline-block;padding:6px 10px;border-radius:999px;background:rgba(241,101,34,0.08);color:var(--orange);font-weight:800">Travel • Visa • Study • Immigration</div> <h1>La passerelle la plus simple pour voyager, étudier et immigrer</h1> <p class="lead">Avec TL Management, bénéficiez d’un accompagnement complet et personnalisé — de la réservation au départ, jusqu’au suivi après arrivée.</p> <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap"> <button class="btn btn-primary" onclick="scrollToId('reservations')">Réserver un Vol</button> <button class="btn" style="background:var(--blue);color:#fff;border-radius:12px" onclick="scrollToId('hotels')">Réserver un Hôtel</button> <button class="btn btn-ghost" onclick="scrollToId('inscription')">S'inscrire</button> </div> <div class="card" style="margin-top:16px"> <div style="display:flex;justify-content:space-between;align-items:center"> <div> <div class="small">Contact rapide</div> <div style="font-weight:900">+243 990890610 • tlmanagement243@gmail.com</div> </div> <div> <div class="small">Suivez-nous</div> <div class="socials" style="margin-top:6px"> <a href="#" aria-label="Facebook">Facebook</a> <a href="#" aria-label="Instagram">Instagram</a> <a href="#" aria-label="YouTube">YouTube</a> </div> </div> </div> </div> <div id="services" class="services" style="margin-top:14px"> <div class="card"> <strong>Assistance Visa</strong> <p class="small">Préparation dossier, rendez-vous ambassade, coaching interview.</p> </div> <div class="card"> <strong>Voyage & Tourisme</strong> <p class="small">Billets, packages, assurance voyage et accompagnement aéroport.</p> </div> <div class="card"> <strong>Études à l'étranger</strong> <p class="small">Orientation, admission, logement étudiant et visa étudiant.</p> </div> </div> </div> <aside class="hero-image card" style="height:360px"> <img src="https://images.unsplash.com/photo-1502920917128-1aa500764b9d?w=1200&q=60&auto=format&fit=crop" alt="Travel"> </aside> </section> <!-- A PROPOS --> <section style="margin-top:18px" id="about"> <div class="card"> <div class="section-title"><h2 style="margin:0">À propos</h2></div> <p class="small">TL Management — Total Link Management, basée à Kinshasa (RDC). Notre mission : faciliter vos projets internationaux avec un service transparent et personnalisé. Slogan : « Prévoir, c’est gérer l’avenir ».</p> </div> </section> <!-- RESERVATIONS --> <section id="reservations" style="margin-top:18px"> <div class="card"> <h3>Réservations</h3> <p class="small">Choisissez ci-dessous : vol ou hôtel. Remplissez le formulaire et un agent vous contactera pour finaliser la réservation et le paiement.</p> <!-- TABS simple --> <div style="display:flex;gap:8px;margin-top:12px"> <button class="btn" id="tab-flight" onclick="showTab('flight')">Vols</button> <button class="btn" id="tab-hotel" onclick="showTab('hotel')">Hôtels</button> <button class="btn" id="tab-visa" onclick="showTab('visa')">Visa</button> </div> <!-- FLIGHT FORM --> <div id="flight" style="margin-top:12px"> <form id="flightForm" onsubmit="submitForm(event,'flight')"> <label>Nom complet <span class="required">*</span></label> <input type="text" id="f_name" required placeholder="Nom et prénom"> <label>Numéro WhatsApp / Téléphone <span class="required">*</span></label> <input type="text" id="f_phone" required placeholder="+243..."> <label>Ville de départ <span class="required">*</span></label> <input type="text" id="f_from" required placeholder="Kinshasa"> <label>Destination <span class="required">*</span></label> <input type="text" id="f_to" required placeholder="Paris"> <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"> <div> <label>Date de départ <span class="required">*</span></label> <input type="date" id="f_depart" required> </div> <div> <label>Date retour (facultatif)</label> <input type="date" id="f_return"> </div> </div> <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"> <div> <label>Classe</label> <select id="f_class"><option>Economique</option><option>Business</option><option>Première</option></select> </div> <div> <label>Passagers</label> <input type="number" id="f_pax" min="1" value="1"> </div> </div> <label>Budget (optionnel)</label> <input type="text" id="f_budget" placeholder="Ex: 800 USD"> <label>Remarques</label> <textarea id="f_notes" rows="3" placeholder="Préférences, escales, compagnies..."></textarea> <div style="margin-top:10px;display:flex;gap:8px;align-items:center"> <button class="btn btn-primary" type="submit">Demander la réservation</button> <div class="form-note">Un agent vous contactera pour confirmation et paiement.</div> </div> </form> </div> <!-- HOTEL FORM --> <div id="hotel" style="display:none;margin-top:12px"> <form id="hotelForm" onsubmit="submitForm(event,'hotel')"> <label>Nom complet <span class="required">*</span></label> <input type="text" id="h_name" required placeholder="Nom et prénom"> <label>Ville / Destination <span class="required">*</span></label> <input type="text" id="h_city" required placeholder="Kinshasa, Nairobi..."> <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"> <div> <label>Arrivée <span class="required">*</span></label> <input type="date" id="h_checkin" required> </div> <div> <label>Départ <span class="required">*</span></label> <input type="date" id="h_checkout" required> </div> </div> <label>Nombre de personnes</label> <input type="number" id="h_pax" min="1" value="1"> <label>Type d'hôtel</label> <select id="h_type"><option>3★</option><option>4★</option><option>5★</option></select> <label>Services souhaités</label> <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px"> <label><input type="checkbox" id="h_breakfast"> Petit-déjeuner</label> <label><input type="checkbox" id="h_pool"> Piscine</label> <label><input type="checkbox" id="h_wifi"> WiFi</label> <label><input type="checkbox" id="h_center"> Proche centre-ville</label> </div> <label>Remarques</label> <textarea id="h_notes" rows="3" placeholder="Préférences..."></textarea> <div style="margin-top:10px;display:flex;gap:8px;align-items:center"> <button class="btn btn-primary" type="submit">Demander la réservation</button> <div class="form-note">Un conseiller vous appellera pour confirmer et finaliser le paiement.</div> </div> </form> </div> <!-- VISA FORM --> <div id="visa" style="display:none;margin-top:12px"> <form id="visaForm" onsubmit="submitForm(event,'visa')"> <label>Nom complet <span class="required">*</span></label> <input type="text" id="v_name" required> <label>Nationalité</label> <input type="text" id="v_nationality"> <label>Pays de destination</label> <input type="text" id="v_to"> <label>Type de visa</label> <select id="v_type"><option>Touristique</option><option>Affaires</option><option>Étudiant</option><option>Travail</option></select> <label>Documents disponibles (upload sur demande)</label> <input type="text" id="v_docs" placeholder="Passeport, lettre d'admission..."> <div style="margin-top:10px;display:flex;gap:8px"> <button class="btn btn-primary" type="submit">Démarrer la demande</button> <div class="form-note">Nous vérifierons votre éligibilité et vous enverrons la checklist.</div> </div> </form> </div> </div> <!-- PAYMENT SUMMARY & METHODS --> <div class="card" style="margin-top:12px" id="payments"> <h4>Méthodes de paiement acceptées</h4> <div class="payment-methods" style="margin-top:8px"> <div class="pay">Airtel Money</div> <div class="pay">M-Pesa</div> <div class="pay">Orange Money</div> <div class="pay">Visa</div> <div class="pay">Binance (USDT)</div> </div> <p class="small" style="margin-top:8px">Numéro officiel TL Management : <strong>+243 990890610</strong></p> <p class="small">Pour Binance (USDT) : utilisez TRC20 ou BEP20. L'adresse sera fournie après confirmation de la réservation.</p> </div> </section> <!-- INSCRIPTION --> <section id="inscription" style="margin-top:18px"> <div class="card"> <h3>S'inscrire chez TL Management</h3> <p class="small">Créez un compte client pour suivre vos dossiers et recevoir des offres.</p> <form id="signupForm" onsubmit="submitForm(event,'signup')"> <label>Nom complet <span class="required">*</span></label> <input type="text" id="s_name" required> <label>Date de naissance</label> <input type="date" id="s_dob"> <label>Email <span class="required">*</span></label> <input type="email" id="s_email" required> <label>Téléphone <span class="required">*</span></label> <input type="text" id="s_phone" placeholder="+243..." required> <label>Ville / Pays</label> <input type="text" id="s_city" value="Kinshasa, RDC"> <label>Service désiré</label> <select id="s_service"> <option>Assistance Visa</option> <option>Études à l'étranger</option> <option>Immigration</option> <option>Réservation Vol</option> <option>Réservation Hôtel</option> </select> <label>Objectif (court)</label> <textarea id="s_goal" rows="3"></textarea> <div style="margin-top:10px;display:flex;gap:8px;align-items:center"> <button class="btn btn-primary" type="submit">S'inscrire</button> <div class="form-note">Nous contacterons les nouveaux inscrits sous 24h.</div> </div> </form> </div> </section> <!-- CONTACT --> <section id="contact" style="margin-top:18px"> <div class="contact-grid"> <div class="card"> <h3>Contactez-nous</h3> <p class="small">Pour toute question, proposez un rendez-vous ou demandez un devis.</p> <form id="contactForm" onsubmit="submitForm(event,'contact')"> <label>Nom</label><input type="text" id="c_name"> <label>Email</label><input type="email" id="c_email"> <label>Téléphone</label><input type="text" id="c_phone" placeholder="+243..."> <label>Message</label><textarea id="c_msg" rows="4"></textarea> <div style="margin-top:10px;display:flex;gap:8px"> <button class="btn btn-primary" type="submit">Envoyer</button> <button type="button" class="btn" onclick="window.open('tel:+243990890610')">Appeler</button> </div> </form> </div> <div class="card"> <h4>Infos rapides</h4> <p class="small"><strong>Adresse :</strong> Kinshasa, République Démocratique du Congo</p> <p class="small"><strong>Téléphone :</strong> +243 990890610</p> <p class="small"><strong>Email :</strong> tlmanagement243@gmail.com</p> <hr style="border:none;border-top:1px solid #eef2f6;margin:12px 0"> <h4>Réseaux sociaux</h4> <div class="socials" style="margin-top:8px"> <a href="#" aria-label="Facebook">Facebook: TL Management</a><br/> <a href="#" aria-label="Instagram">Instagram: TL Management</a><br/> <a href="#" aria-label="YouTube">YouTube: TL Management</a> </div> <hr style="border:none;border-top:1px solid #eef2f6;margin:12px 0"> <div> <h4>Sécurité des paiements</h4> <p class="small">Après validation, un agent vous communiquera les coordonnées exactes (numéro Airtel Money, Orange Money, M-Pesa) ou l'adresse USDT Binance selon votre choix.</p> </div> </div> </div> </section> <footer> © <span id="year"></span> TL Management — Tous droits réservés • Kinshasa, RDC </footer> </main> </div> <script> document.getElementById('year').textContent = new Date().getFullYear(); // simple tab show function showTab(id){ ['flight','hotel','visa'].forEach(t => { document.getElementById(t).style.display = (t===id)?'block':'none'; }); } // default showTab('flight'); function scrollToId(id){ document.getElementById(id).scrollIntoView({behavior:'smooth'}); } // FORM HANDLER (simulé) - remplace FORM_ENDPOINT par ton vrai endpoint const FORM_ENDPOINT = 'https://example.com/FORM_ENDPOINT'; // <-- change this async function submitForm(e, type){ e.preventDefault(); // Collect according to form type (some basic examples) let payload = {type:type, timestamp: new Date().toISOString()}; if(type==='flight'){ payload.name = document.getElementById('f_name').value; payload.phone = document.getElementById('f_phone').value; payload.from = document.getElementById('f_from').value; payload.to = document.getElementById('f_to').value; payload.depart = document.getElementById('f_depart').value; payload.return = document.getElementById('f_return').value; payload.pax = document.getElementById('f_pax').value; payload.notes = document.getElementById('f_notes').value; } else if(type==='hotel'){ payload.name = document.getElementById('h_name').value; payload.city = document.getElementById('h_city').value; payload.checkin = document.getElementById('h_checkin').value; payload.checkout = document.getElementById('h_checkout').value; payload.pax = document.getElementById('h_pax').value; payload.notes = document.getElementById('h_notes').value; } else if(type==='visa'){ payload.name = document.getElementById('v_name').value; payload.nationality = document.getElementById('v_nationality').value; payload.to = document.getElementById('v_to').value; } else if(type==='signup'){ payload.name = document.getElementById('s_name').value; payload.email = document.getElementById('s_email').value; payload.phone = document.getElementById('s_phone').value; payload.service = document.getElementById('s_service').value; } else if(type==='contact'){ payload.name = document.getElementById('c_name').value; payload.email = document.getElementById('c_email').value; payload.phone = document.getElementById('c_phone').value; payload.message = document.getElementById('c_msg').value; } else { // generic fallback payload.notes = 'unknown form'; } // Basic client validation if(!payload.name || (type==='flight' && !payload.phone)){ alert('Merci de remplir les champs obligatoires.'); return; } // Simulated send - replace with fetch to real endpoint try { // Example send: // await fetch(FORM_ENDPOINT, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)}); console.log('FORM SUBMIT', payload); alert('Merci — votre demande a été reçue. Un agent TL Management vous contactera sous 24h.'); // reset relevant form fields (simple approach) const forms = {flight:'#flightForm', hotel:'#hotelForm', visa:'#visaForm', signup:'#signupForm', contact:'#contactForm'}; if(forms[type]) document.querySelector(forms[type]).reset(); } catch(err){ console.error(err); alert('Erreur d’envoi. Essaie de nouveau plus tard.'); } } </script> </body> </html
